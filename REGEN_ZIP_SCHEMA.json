{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tiddlywiki.com/schemas/regen-zip-v1.json",
  "title": "REGEN-ZIP Tiddler Schema",
  "description": "JSON Schema for TiddlyWiki tiddlers with REGEN-ZIP VM support",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Tiddler title (address in VM)",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "description": "Tiddler text content (code or content)"
    },
    "type": {
      "type": "string",
      "description": "MIME type of tiddler content",
      "default": "text/vnd.tiddlywiki"
    },
    "tags": {
      "oneOf": [
        {
          "type": "string",
          "description": "Space-separated tag list"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of tags"
        }
      ]
    },
    "regen-zip": {
      "type": "string",
      "description": "REGEN-ZIP data: base64-encoded, external reference, or generator name",
      "pattern": "^(data:application/zip;base64,[A-Za-z0-9+/=]+|https?://.*|[a-zA-Z][a-zA-Z0-9_-]*)$"
    },
    "generator": {
      "type": "string",
      "description": "Name of registered generator function",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "seed": {
      "type": "string",
      "description": "Seed hash for deterministic generation",
      "minLength": 1
    },
    "zp35": {
      "type": "string",
      "description": "ZP35 coherence signature (format: {fractalCoord}.{ordinalHeight})",
      "pattern": "^[0-1]\\.[0-9]+\\.[0-9]+$"
    },
    "version": {
      "type": "string",
      "description": "Semantic version of generator (MAJOR.MINOR.PATCH)",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "created": {
      "type": "string",
      "description": "Creation timestamp"
    },
    "modified": {
      "type": "string",
      "description": "Last modification timestamp"
    },
    "creator": {
      "type": "string",
      "description": "Creator username"
    },
    "modifier": {
      "type": "string",
      "description": "Last modifier username"
    }
  },
  "required": ["title"],
  "additionalProperties": true,
  "definitions": {
    "regenZipAsset": {
      "type": "object",
      "description": "Asset generated by REGEN-ZIP VM",
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique asset identifier",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "MIME type of asset",
          "pattern": "^[a-zA-Z]+/[a-zA-Z0-9.+_-]+$"
        },
        "data": {
          "description": "Asset content (any type)"
        },
        "checksum": {
          "type": "string",
          "description": "Optional checksum for verification",
          "pattern": "^[a-fA-F0-9]+$"
        },
        "size": {
          "type": "integer",
          "description": "Size in bytes",
          "minimum": 0
        },
        "metadata": {
          "type": "object",
          "description": "Additional asset metadata",
          "additionalProperties": true
        }
      },
      "required": ["name", "type", "data"]
    },
    "generatorMetadata": {
      "type": "object",
      "description": "Generator function metadata",
      "properties": {
        "version": {
          "type": "string",
          "description": "Generator version (semver)",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "seed": {
          "type": "string",
          "description": "Default seed value",
          "nullable": true
        },
        "zp35": {
          "type": "string",
          "description": "Generator's ZP35 signature",
          "pattern": "^[0-1]\\.[0-9]+\\.[0-9]+$",
          "nullable": true
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "author": {
          "type": "string",
          "description": "Generator author"
        },
        "license": {
          "type": "string",
          "description": "License identifier (SPDX)"
        },
        "dependencies": {
          "type": "array",
          "description": "Required dependencies",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "description": "Configurable parameters",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "number", "boolean", "array", "object"]
              },
              "default": {
                "description": "Default value"
              },
              "description": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "required": ["version"]
    },
    "zp35CoherenceResult": {
      "type": "object",
      "description": "Result of ZP35 coherence check",
      "properties": {
        "allowed": {
          "type": "boolean",
          "description": "Whether operation is allowed"
        },
        "mode": {
          "type": "string",
          "enum": ["safe", "caution", "blocked", "error", "unchecked"],
          "description": "Coherence mode"
        },
        "distance": {
          "type": "number",
          "description": "Semantic distance in [0, 1]",
          "minimum": 0,
          "maximum": 1,
          "nullable": true
        },
        "confidence": {
          "type": "number",
          "description": "Confidence level in [0, 1]",
          "minimum": 0,
          "maximum": 1
        },
        "message": {
          "type": "string",
          "description": "Human-readable message"
        },
        "suggestions": {
          "type": "array",
          "description": "Mediation suggestions (for caution mode)",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "priority": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              }
            }
          }
        },
        "alternatives": {
          "type": "array",
          "description": "Alternative suggestions (for blocked mode)",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        "sourceCoord": {
          "type": "number",
          "description": "Source fractal coordinate",
          "nullable": true
        },
        "targetCoord": {
          "type": "number",
          "description": "Target fractal coordinate",
          "nullable": true
        }
      },
      "required": ["allowed", "mode", "confidence", "message"]
    },
    "vmInstruction": {
      "type": "object",
      "description": "REGEN-ZIP VM instruction",
      "properties": {
        "opcode": {
          "type": "integer",
          "description": "Opcode value",
          "minimum": 1,
          "maximum": 6,
          "enum": [1, 2, 3, 4, 5, 6]
        },
        "opcodeName": {
          "type": "string",
          "enum": [
            "OP_SEED",
            "OP_GENERATOR",
            "OP_VERIFY",
            "OP_ATTACH",
            "OP_ZP35_CHECK",
            "OP_TW_INSERT"
          ]
        },
        "data": {
          "description": "Opcode-specific data"
        },
        "metadata": {
          "type": "object",
          "description": "Optional instruction metadata",
          "additionalProperties": true
        }
      },
      "required": ["opcode"]
    },
    "vmExecutionResult": {
      "type": "object",
      "description": "Result of VM execution",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether execution succeeded"
        },
        "assets": {
          "type": "array",
          "description": "Generated assets",
          "items": {
            "$ref": "#/definitions/regenZipAsset"
          }
        },
        "metadata": {
          "type": "object",
          "description": "Execution metadata",
          "properties": {
            "seed": {
              "type": "string"
            },
            "generator": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "zp35": {
              "type": "string"
            },
            "coherence": {
              "$ref": "#/definitions/zp35CoherenceResult"
            },
            "instructions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/vmInstruction"
              }
            },
            "duration": {
              "type": "number",
              "description": "Execution time in milliseconds"
            }
          }
        },
        "error": {
          "type": "string",
          "description": "Error message (if success=false)"
        }
      },
      "required": ["success"]
    }
  },
  "examples": [
    {
      "title": "FractalArt",
      "type": "application/javascript",
      "generator": "mandelbrotGenerator",
      "seed": "golden-seed-2024",
      "zp35": "0.618034.15",
      "version": "1.0.0",
      "regen-zip": "mandelbrotGenerator",
      "text": "This tiddler generates fractal art using the Mandelbrot generator",
      "tags": ["art", "fractal", "generative"]
    },
    {
      "title": "AdaptiveTheme",
      "type": "text/css",
      "generator": "themeGenerator",
      "seed": "theme-seed-dark",
      "zp35": "0.500000.20",
      "version": "2.1.0",
      "regen-zip": "data:application/zip;base64,UEsDBBQAAAAIAA==",
      "text": "Adaptive theme that generates CSS based on user preferences",
      "tags": ["$:/tags/Stylesheet", "theme"]
    },
    {
      "title": "Documentation",
      "type": "text/vnd.tiddlywiki",
      "generator": "docGenerator",
      "seed": "docs-v1",
      "zp35": "0.382000.18",
      "version": "1.2.3",
      "regen-zip": "https://example.com/doc-assets.zip",
      "text": "Live documentation that regenerates from code",
      "tags": ["documentation", "live"]
    }
  ]
}
