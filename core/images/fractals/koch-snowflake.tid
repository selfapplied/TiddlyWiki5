title: $:/core/images/fractals/koch-snowflake
tags: $:/tags/Image $:/tags/FractalBackground
caption: Koch Snowflake
description: A beautiful snowflake-like fractal with six-fold symmetry

\parameters (width:"100%" height:"100%")
<svg width=<<width>> height=<<height>> class="tc-fractal-background" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice">
<defs>
<pattern id="koch-snowflake-pattern" x="0" y="0" width="500" height="500" patternUnits="userSpaceOnUse">
<g transform="translate(250, 250)">
<!-- Level 0 - Base triangle -->
<polygon points="0,-150 130,75 -130,75" fill="none" stroke="<<colour primary>>" stroke-width="2" opacity="0.15"/>
<!-- Level 1 iterations -->
<path d="M 0,-150 L 43.33,-100 L 0,-50 L -43.33,-100 Z" fill="none" stroke="<<colour primary>>" stroke-width="1.5" opacity="0.2"/>
<path d="M 130,75 L 86.67,25 L 43.33,75 L 86.67,125 Z" fill="none" stroke="<<colour primary>>" stroke-width="1.5" opacity="0.2"/>
<path d="M -130,75 L -86.67,25 L -43.33,75 L -86.67,125 Z" fill="none" stroke="<<colour primary>>" stroke-width="1.5" opacity="0.2"/>
<!-- Level 2 - Smaller details -->
<circle cx="0" cy="-150" r="5" fill="<<colour primary>>" opacity="0.25"/>
<circle cx="130" cy="75" r="5" fill="<<colour primary>>" opacity="0.25"/>
<circle cx="-130" cy="75" r="5" fill="<<colour primary>>" opacity="0.25"/>
<circle cx="0" cy="-50" r="3" fill="<<colour primary>>" opacity="0.3"/>
<circle cx="43.33" cy="75" r="3" fill="<<colour primary>>" opacity="0.3"/>
<circle cx="-43.33" cy="75" r="3" fill="<<colour primary>>" opacity="0.3"/>
<!-- Inner hexagonal pattern -->
<polygon points="0,-50 43.33,-25 43.33,25 0,50 -43.33,25 -43.33,-25" fill="none" stroke="<<colour primary>>" stroke-width="1" opacity="0.25"/>
</g>
</pattern>
</defs>
<rect width="100%" height="100%" fill="url(#koch-snowflake-pattern)"/>
</svg>
